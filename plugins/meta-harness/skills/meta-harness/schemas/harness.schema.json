{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/meta-harness/harness.schema.json",
  "title": "Meta Harness Manifest",
  "description": "Schema for generated Codex meta-harness manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "harness",
    "execution",
    "context",
    "roles",
    "skills",
    "eval",
    "agents_pointer"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "harness": {
      "$ref": "#/$defs/harness"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "eval": {
      "$ref": "#/$defs/eval"
    },
    "agents_pointer": {
      "$ref": "#/$defs/agentsPointer"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pathString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "description",
        "domain",
        "owner_mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "domain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner_mode": {
          "type": "string",
          "enum": [
            "repo-local",
            "generated",
            "user-home"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "runtime_mode",
        "delegation_policy",
        "task_ledger_path",
        "artifact_root"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "sequential",
            "fanout-fanin",
            "router",
            "review-loop"
          ]
        },
        "runtime_mode": {
          "type": "string",
          "enum": [
            "single",
            "delegated",
            "hybrid"
          ]
        },
        "delegation_policy": {
          "type": "string",
          "enum": [
            "on-user-request",
            "always-if-allowed",
            "disabled"
          ]
        },
        "task_ledger_path": {
          "$ref": "#/$defs/pathString"
        },
        "artifact_root": {
          "$ref": "#/$defs/pathString"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_paths"
      ],
      "properties": {
        "target_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "readme_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "instruction_files": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "agent_type",
        "model",
        "reasoning_effort",
        "inputs",
        "outputs",
        "responsibilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "coordinator",
            "specialist",
            "executor",
            "validator"
          ]
        },
        "agent_type": {
          "type": "string",
          "enum": [
            "default",
            "explorer",
            "worker"
          ]
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "mission": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/stringArray"
        },
        "outputs": {
          "$ref": "#/$defs/stringArray"
        },
        "responsibilities": {
          "$ref": "#/$defs/stringArray"
        },
        "handoff": {
          "$ref": "#/$defs/handoff"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_spawn": {
          "$ref": "#/$defs/stringArray"
        },
        "can_message": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "$ref": "#/$defs/pathString"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trigger_keywords": {
          "$ref": "#/$defs/stringArray"
        },
        "inputs": {
          "$ref": "#/$defs/stringArray"
        },
        "workflow": {
          "$ref": "#/$defs/stringArray"
        },
        "outputs": {
          "$ref": "#/$defs/stringArray"
        },
        "constraints": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "baseline_mode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseline_mode": {
          "type": "string",
          "enum": [
            "no-harness",
            "single-agent",
            "manual"
          ]
        },
        "trigger_checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "should_trigger_min": {
              "type": "integer",
              "minimum": 0
            },
            "should_not_trigger_min": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "iterations_dir": {
          "$ref": "#/$defs/pathString"
        }
      }
    },
    "agentsPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_file",
        "section_title",
        "update_mode"
      ],
      "properties": {
        "target_file": {
          "type": "string",
          "const": "AGENTS.md"
        },
        "section_title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "update_mode": {
          "type": "string",
          "enum": [
            "patch",
            "append",
            "replace-section"
          ]
        },
        "append_history": {
          "type": "boolean"
        }
      }
    }
  }
}
